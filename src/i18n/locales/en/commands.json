{
  "ban_user": {
    "description": "Start a vote; 5 votes within 1 minute time the member out for 1-5 minutes",
    "options": {
      "user": {
        "description": "Member to vote on"
      },
      "duration": {
        "description": "Timeout length in minutes (1-5, default 1)"
      }
    }
  },
  "bug_report": {
    "description": "Report a bug",
    "options": {
      "content": {
        "description": "Bug description"
      }
    }
  },
  "change_avatar": {
    "description": "Switch the bot's persona (avatar, nickname and colour)",
    "options": {
      "identity": {
        "description": "Persona to switch to"
      }
    }
  },
  "gay": {
    "description": "Are they gay",
    "options": {
      "user": {
        "description": "Choose a target"
      }
    }
  },
  "give_score": {
    "description": "Give a score"
  },
  "help": {
    "description": "Show the command list and help"
  },
  "level_detail": {
    "description": "Show MEE6 leaderboard details for a range of ranks",
    "options": {
      "rank_from": {
        "description": "First rank to show"
      },
      "count": {
        "description": "How many ranks to show (1-10, default 10)"
      }
    }
  },
  "menu_get_avatar": {
    "name": "Get user avatar URL"
  },
  "menu_get_sticker": {
    "name": "Get emoji/sticker URL"
  },
  "random_restaurant": {
    "description": "Random restaurant picker (Taipei / parts of New Taipei)",
    "options": {
      "type": {
        "description": "Restaurant type"
      },
      "name_keyword": {
        "description": "Restaurant name keyword"
      },
      "address_keyword": {
        "description": "Restaurant address keyword"
      },
      "budget": {
        "description": "Maximum budget (TWD)"
      },
      "min_rating": {
        "description": "Minimum rating (0-5, decimals allowed)"
      },
      "max_rating": {
        "description": "Maximum rating (0-5, decimals allowed)"
      }
    }
  },
  "role_message": {
    "description": "Send a role-claim message",
    "options": {
      "roles": {
        "description": "Claimable role IDs (ex: @role1 @role2...)"
      }
    }
  },
  "roll_call": {
    "description": "Roll call",
    "options": {
      "users": {
        "description": "Users or roles to call (ex: @user1 @role1 @user2...)"
      },
      "activity_id": {
        "description": "Activity ID (used to roll-call activity participants)"
      }
    }
  },
  "talk": {
    "description": "[Admin] Make the bot speak without a signature",
    "options": {
      "channel": {
        "description": "Choose a channel"
      },
      "content": {
        "description": "The content"
      }
    }
  },
  "talk_signed": {
    "description": "Make the bot speak (signed)",
    "options": {
      "content": {
        "description": "The content"
      }
    }
  },
  "temp_role": {
    "description": "Create a temporary notification role that anyone can claim; it is deleted automatically when it expires",
    "options": {
      "name": {
        "description": "Role name"
      },
      "days": {
        "description": "Lifetime in days (1-30, default 30)"
      }
    }
  },
  "update_role": {
    "description": "Update Mee6 level roles"
  },
  "archive": {
    "description": "Manage msg-archive's full backup and periodic backup",
    "subcommands": {
      "backup": {
        "description": "Start, resume or stop the full backup"
      },
      "status": {
        "description": "Show archive status in one panel"
      },
      "schedule": {
        "description": "Show or change the periodic backup schedule",
        "options": {
          "enabled": {
            "description": "Enable or disable periodic backup (unchanged when omitted)"
          },
          "minutes": {
            "description": "Minutes between passes, 1–10080 (unchanged when omitted)"
          }
        }
      }
    }
  },
  "feed": {
    "description": "Manage social feed subscriptions",
    "subcommands": {
      "subscribe": {
        "description": "Forward a social account's new posts into a channel",
        "options": {
          "platform": {
            "description": "Social platform the account is on",
            "choices": {
              "x": "X (Twitter)"
            }
          },
          "account": {
            "description": "Account handles, comma-separated; the leading @ is optional"
          },
          "channel": {
            "description": "Channel to forward into (default: this channel)"
          },
          "media": {
            "description": "Which posts to forward, by attached media",
            "choices": {
              "media_only": "Only posts with a photo or video, no text-only posts",
              "photo_only": "Only posts with a photo",
              "video_only": "Only posts with a video",
              "any": "Every post: text-only, photo and video"
            }
          },
          "keyword": {
            "description": "Only forward posts whose text contains this (max 100 characters)"
          }
        }
      },
      "unsubscribe": {
        "description": "Stop forwarding social posts into a channel",
        "options": {
          "channel": {
            "description": "Channel to unsubscribe (default: this channel)"
          },
          "platform": {
            "description": "Only remove subscriptions on this platform",
            "choices": {
              "x": "X (Twitter)"
            }
          },
          "account": {
            "description": "Only remove subscriptions to these accounts, comma-separated"
          }
        }
      },
      "list": {
        "description": "List this server's social feed subscriptions"
      }
    }
  },
  "reply": {
    "description": "Manage automatic replies",
    "subcommands": {
      "add": {
        "description": "Add an auto-reply: the bot answers messages that exactly match the keyword",
        "options": {
          "keyword": {
            "description": "The exact message that triggers it; [*] means a random interjection"
          },
          "reply": {
            "description": "What the bot replies with"
          }
        }
      },
      "delete": {
        "description": "Delete a keyword's auto-replies",
        "options": {
          "keyword": {
            "description": "Keyword"
          }
        }
      },
      "list": {
        "description": "List auto-replies",
        "options": {
          "keyword": {
            "description": "Only this keyword (omit to list every keyword)"
          }
        }
      }
    }
  },
  "activity": {
    "description": "Manage activities",
    "subcommands": {
      "create": {
        "description": "Create an activity",
        "options": {
          "title": {
            "description": "Activity title"
          },
          "duration": {
            "description": "Activity duration (1s, 1m, 1h, 1d, 1w)"
          },
          "description": {
            "description": "Activity description (optional)"
          }
        }
      },
      "delete": {
        "description": "Delete an activity",
        "options": {
          "activity_id": {
            "description": "Activity ID"
          }
        }
      }
    }
  },
  "giveaway": {
    "description": "Manage giveaways",
    "subcommands": {
      "create": {
        "description": "Create a giveaway (opens a form for the prize, winners and duration)",
        "options": {
          "destination": {
            "description": "Where to publish the giveaway (default: current channel)",
            "choices": {
              "current": "Current channel",
              "configured": "Configured giveaway channel"
            }
          }
        }
      },
      "delete": {
        "description": "Cancel an active giveaway"
      }
    }
  },
  "ai": {
    "description": "Manage AI settings and access",
    "subcommands": {
      "settings": {
        "description": "Edit your AI settings in one go (model / temperature / web search / system prompt)",
        "options": {
          "provider": {
            "description": "Choose an AI provider; model candidates will load dynamically based on it"
          }
        }
      },
      "status": {
        "description": "Show your current AI settings"
      }
    },
    "groups": {
      "whitelist": {
        "subcommands": {
          "add": {
            "description": "[Admin] Add a user to the AI whitelist",
            "options": {
              "user": {
                "description": "The user to add to the whitelist"
              }
            }
          },
          "remove": {
            "description": "[Admin] Remove a user from the AI whitelist",
            "options": {
              "user": {
                "description": "The user to remove"
              }
            }
          },
          "list": {
            "description": "[Admin] List all users currently on the AI whitelist"
          }
        },
        "description": "Manage AI allowlist"
      }
    }
  },
  "thread": {
    "description": "Manage threads",
    "subcommands": {
      "ban": {
        "description": "Restrict users in this thread for this bot",
        "options": {
          "users": {
            "description": "1–20 user mentions or IDs, separated by spaces or commas"
          }
        }
      },
      "allow": {
        "description": "Restore users’ rights in this thread for this bot",
        "options": {
          "users": {
            "description": "1–20 user mentions or IDs, separated by spaces or commas"
          }
        }
      },
      "list": {
        "description": "List users this bot restricts in the current thread"
      },
      "claim": {
        "description": "Request delegated management of a thread",
        "options": {
          "thread": {
            "description": "Thread to manage (defaults to the current thread)"
          },
          "reason": {
            "description": "Reason for the request (1–1000 characters)"
          }
        }
      }
    },
    "groups": {
      "manager": {
        "description": "Manage delegated thread managers (bot admins only)",
        "subcommands": {
          "add": {
            "description": "Grant thread management",
            "options": {
              "thread": {
                "description": "Target thread (defaults to the current thread)"
              },
              "user": {
                "description": "Target user"
              }
            }
          },
          "remove": {
            "description": "Revoke thread management",
            "options": {
              "thread": {
                "description": "Target thread (defaults to the current thread)"
              },
              "user": {
                "description": "Target user"
              }
            }
          },
          "list": {
            "description": "List a thread's delegated managers",
            "options": {
              "thread": {
                "description": "Target thread (defaults to the current thread)"
              },
              "page": {
                "description": "Page number (20 users per page)"
              }
            }
          }
        }
      }
    }
  },
  "traffic": {
    "description": "View message activity statistics",
    "subcommands": {
      "overview": {
        "description": "Show server activity: counts, trend, rankings, heat map and top messages",
        "options": {
          "range": {
            "description": "Look-back window (optional, default: 7d)",
            "choices": {
              "24h": "Last 24 hours",
              "7d": "Last 7 days",
              "30d": "Last 30 days",
              "90d": "Last 90 days",
              "365d": "Last 365 days"
            }
          },
          "visibility": {
            "description": "Who can see the reply (optional, default: public)",
            "choices": {
              "ephemeral": "Only you",
              "public": "Everyone"
            }
          }
        }
      },
      "channel": {
        "description": "Show one channel's activity",
        "options": {
          "channel": {
            "description": "Channel, forum or thread to look up"
          },
          "include_threads": {
            "description": "Include the threads under the channel (optional, default: true)"
          },
          "range": {
            "description": "Look-back window (optional, default: 7d)",
            "choices": {
              "24h": "Last 24 hours",
              "7d": "Last 7 days",
              "30d": "Last 30 days",
              "90d": "Last 90 days",
              "365d": "Last 365 days"
            }
          },
          "visibility": {
            "description": "Who can see the reply (optional, default: public)",
            "choices": {
              "ephemeral": "Only you",
              "public": "Everyone"
            }
          }
        }
      },
      "me": {
        "description": "Show your own activity",
        "options": {
          "range": {
            "description": "Look-back window (optional, default: 7d)",
            "choices": {
              "24h": "Last 24 hours",
              "7d": "Last 7 days",
              "30d": "Last 30 days",
              "90d": "Last 90 days",
              "365d": "Last 365 days"
            }
          },
          "visibility": {
            "description": "Who can see the reply (optional, default: public)",
            "choices": {
              "ephemeral": "Only you",
              "public": "Everyone"
            }
          }
        }
      },
      "user": {
        "description": "Show a member's activity",
        "options": {
          "user": {
            "description": "Member to look up"
          },
          "range": {
            "description": "Look-back window (optional, default: 7d)",
            "choices": {
              "24h": "Last 24 hours",
              "7d": "Last 7 days",
              "30d": "Last 30 days",
              "90d": "Last 90 days",
              "365d": "Last 365 days"
            }
          },
          "visibility": {
            "description": "Who can see the reply (optional, default: ephemeral)",
            "choices": {
              "ephemeral": "Only you",
              "public": "Everyone"
            }
          }
        }
      },
      "apps": {
        "description": "Show command and app usage",
        "options": {
          "app": {
            "description": "Only this bot (optional)"
          },
          "range": {
            "description": "Look-back window (optional, default: 7d)",
            "choices": {
              "24h": "Last 24 hours",
              "7d": "Last 7 days",
              "30d": "Last 30 days",
              "90d": "Last 90 days",
              "365d": "Last 365 days"
            }
          },
          "visibility": {
            "description": "Who can see the reply (optional, default: public)",
            "choices": {
              "ephemeral": "Only you",
              "public": "Everyone"
            }
          }
        }
      },
      "emoji": {
        "description": "Show use of this server's custom emoji",
        "options": {
          "order": {
            "description": "Order of the ranking (optional, default: most)",
            "choices": {
              "most": "Most used first",
              "least": "Least used first"
            }
          },
          "kind": {
            "description": "Static or animated emoji (optional, default: all)",
            "choices": {
              "all": "All",
              "static": "Static",
              "animated": "Animated"
            }
          },
          "source": {
            "description": "Count message text, reactions or both (optional, default: all)",
            "choices": {
              "all": "Both",
              "message": "Message text",
              "reaction": "Reactions"
            }
          },
          "range": {
            "description": "Look-back window (optional, default: 30d)",
            "choices": {
              "24h": "Last 24 hours",
              "7d": "Last 7 days",
              "30d": "Last 30 days",
              "90d": "Last 90 days",
              "365d": "Last 365 days"
            }
          },
          "visibility": {
            "description": "Who can see the reply (optional, default: public)",
            "choices": {
              "ephemeral": "Only you",
              "public": "Everyone"
            }
          },
          "top_n": {
            "description": "How many entries to rank (optional, 1-20, default: 20)"
          }
        }
      },
      "sticker": {
        "description": "Show use of this server's stickers",
        "options": {
          "order": {
            "description": "Order of the ranking (optional, default: most)",
            "choices": {
              "most": "Most used first",
              "least": "Least used first"
            }
          },
          "range": {
            "description": "Look-back window (optional, default: 30d)",
            "choices": {
              "24h": "Last 24 hours",
              "7d": "Last 7 days",
              "30d": "Last 30 days",
              "90d": "Last 90 days",
              "365d": "Last 365 days"
            }
          },
          "visibility": {
            "description": "Who can see the reply (optional, default: public)",
            "choices": {
              "ephemeral": "Only you",
              "public": "Everyone"
            }
          },
          "top_n": {
            "description": "How many entries to rank (optional, 1-12, default: 12)"
          }
        }
      }
    }
  }
}

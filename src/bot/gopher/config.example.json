{
  "admin": ["YOUR_ADMIN_USER_ID"],
  "language": "zh-TW",
  "guilds": {
    "YOUR_GUILD_ID": {
      "channels": { "debug": "YOUR_DEBUG_CHANNEL_ID" },
      "permission_rank": {
        "channels": {
          "YOUR_PRIVATE_CHANNEL_ID": 1
        },
        "features": {
          "channel_logging": {
            "maxChannelRank": 0
          }
        }
      }
    }
  },
  "commands": ["help"],
  "llm_auto_reply": {
    "enabled": false,
    "probability": 0.05,
    "messageCount": 5,
    "windowSeconds": 30,
    "cooldownSeconds": 30,
    "endpoint": "https://YOUR_LLM_HOST/chat",
    "timeoutMs": 10000
  },
  "settings_api": { "enabled": false, "host": "127.0.0.1", "basePath": "/settings" },
  "identity_sync": {
    "enabled": false,
    "syncWithSource": false,
    "sourceUserId": "YOUR_SOURCE_USER_ID",
    "schedule": "0 4 * * *",
    "syncAvatar": true,
    "syncNickname": true,
    "fallbackNickname": "老鼠人",
    "fallbackAvatarPath": "assets/gopher.png"
  }
}

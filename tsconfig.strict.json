{
  // Strict type-check project (`npm run typecheck`). Everything about
  // module resolution — target, `baseUrl`, the path-alias table — is
  // inherited from `tsconfig.json`, which stays the single place an
  // alias is declared. This file adds only the strictness flags and
  // widens the include to the trees the base config leaves out.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,

    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useUnknownInCatchVariables": true,

    "types": ["node"]
  },
  // Strict-mode scope: the whole `src` tree plus every first-party
  // tree the base config omits (`tools/**` holds the ops CLIs).
  "include": ["src/**/*", "scripts/**/*", "test/**/*", "tools/**/*"],
  "exclude": ["node_modules", "dist"]
}

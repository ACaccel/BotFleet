{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/*.ts",
    "src/register.ts",
    "src/bot/*/index.ts",
    "tools/db/db.ts",
    "tools/archive-benchmark/cpu.ts",
    "tools/archive-benchmark/cpu-persistence.ts",
    "tools/archive-benchmark/rest.ts",
    "tools/archive-benchmark/notifications.ts",
    "tools/archive-benchmark/pipeline.ts",
    "tools/archive-benchmark/stats.ts",
    "tools/archive-benchmark/worker.ts",
    "tools/archive-benchmark/reobserve.ts",
    "tools/archive-benchmark/storage.ts"
  ],
  "project": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts", "tools/**/*.ts"],
  "vitest": {
    "config": ["vitest.config.ts", "vitest.workspace.ts"],
    "entry": ["test/**/*.test.ts", "test/**/setup.ts"]
  },
  "paths": {
    "@bot": ["src/bot/index.ts"],
    "@cmd": ["src/handlers/commands/index.ts"],
    "@button": ["src/handlers/buttons/index.ts"],
    "@select-menu": ["src/handlers/select-menus/index.ts"],
    "@modal": ["src/handlers/modals/index.ts"],
    "@reaction": ["src/handlers/reactions/index.ts"],
    "@core/*": ["src/core/*"],
    "@plugins": ["src/plugins/index.ts"]
  },
  "ignoreBinaries": ["systemd-analyze", "mkfifo"],
  "ignoreDependencies": ["tsconfig-paths", "audit-ci", "prettier"],
  "ignore": [
    "src/persistence/index.ts",
    "src/persistence/repositories/index.ts",
    "src/persistence/schemas/index.ts",
    "src/core/index.ts",
    "src/core/i18n/index.ts",
    "src/core/config/index.ts",
    "src/core/errors/index.ts",
    "src/core/ioc/index.ts",
    "src/core/plugin/index.ts",
    "src/core/result/index.ts",
    "src/infra/llm/index.ts",
    "src/infra/link-preview/index.ts",
    "src/infra/mongo/index.ts",
    "src/infra/social-feed/index.ts",
    "src/handlers/*/index.ts"
  ],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "duplicates": "error",
    "exports": "error",
    "types": "error",
    "nsExports": "error",
    "nsTypes": "error",
    "enumMembers": "error"
  }
}
